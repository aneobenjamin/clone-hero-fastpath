# Copy this file to .env and fill in the values.
# NEO4J_URI/USERNAME/PASSWORD/DATABASE and AURA_INSTANCEID point at the single shared
# AuraDB instance used for this lab -- everyone in the room uses the SAME values here
# (you'll be handed these rather than downloading your own "Connection details" file).
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=

# Needed only for similar_song_fast_path.ipynb, to open your OWN GDS Session against
# the shared instance above. These ARE personal -- each person needs their own Aura API
# credentials (Aura Console > your project > "API" / "Aura API credentials" for the
# client id/secret and project id). AURA_CLIENT_ID is what keeps your session name
# unique from everyone else's, since AURA_INSTANCEID above is the same for the room.
AURA_CLIENT_ID=
AURA_CLIENT_SECRET=
AURA_PROJECT_ID=
